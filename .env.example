# ===== COPY THIS FILE AS ".env" AND FILL IN =====
# Every variable the bot reads is listed here. On Render, add the same names under Environment.
# Lines starting with # are comments. Never share your real .env.

# ---------------------------------------------------------------- Discord
# Bot token: https://discord.com/developers/applications > your app > Bot > Reset Token
DISCORD_TOKEN=your-bot-token
# Application ID: Developer Portal > your app > General Information > Application ID
CLIENT_ID=123456789012345678
# Your HΛVØCZ server ID: right-click the server icon > Copy Server ID (Developer Mode on)
GUILD_ID=123456789012345678

# ---------------------------------------------------------------- Multi-server (NEW)
# Your own Discord user ID (right-click your name > Copy User ID). Only this user can use /admin
OWNER_ID=123456789012345678
# The home server (HΛVØCZ): same number as GUILD_ID. It keeps all settings below and always has every feature
HOME_GUILD_ID=123456789012345678
# Free trial length in days for a new server (one trial per server, ever)
TRIAL_DAYS=15
# Max AI calls per day for each other server (cost control; HΛVØCZ has no limit)
DEFAULT_DAILY_AI_LIMIT=300
# Payment / contact text shown when a trial or paid period ends and on locked premium commands (one line)
SUPPORT_CONTACT=To keep premium, contact remo.sol on Discord.
# optional: only change these if you rename things (defaults shown)
# HOME_GUILD_NAME=HΛVØCZ
# CREATOR_NAME=remo.sol

# ---------------------------------------------------------------- Supabase (Project Settings > API)
# Project URL
SUPABASE_URL=https://your-project.supabase.co
# service_role key (secret, never share / never put in frontend)
SUPABASE_SERVICE_KEY=your-service-role-key

# ---------------------------------------------------------------- AI
# openai  OR  anthropic
AI_PROVIDER=openai
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-key
# model name used for every AI call
OPENAI_MODEL=gpt-4o-mini
# only needed when AI_PROVIDER=anthropic (https://console.anthropic.com > API keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ---------------------------------------------------------------- HΛVØCZ channel / role IDs
# (Developer Mode on > right-click a channel or role > Copy ID. These are for HΛVØCZ only;
#  other servers get their channels from the automatic setup and /setup.)
# Q&A channel: bot answers community questions here (stays silent on casual chat)
ASK_CHANNEL_ID=
# daily top chatter announcement goes here. Number guess games also always run here.
GENERAL_CHANNEL_ID=
# the shop channel (make it read-only for members); also linked in the welcome message
MARKETPLACE_CHANNEL_ID=
# new-member welcome messages go here (empty = no welcomes). Needs "Server Members Intent" ON (Developer Portal > Bot)
WELCOME_CHANNEL_ID=
# optional: rules channel, linked in the welcome message
RULES_CHANNEL_ID=
# admin-only log of every purchase (purchase records ONLY; feature logs never go here)
REDEEM_LOGS_CHANNEL_ID=
# NEW: HΛVØCZ's private logs channel for feature logs and notices: SOL / NFT Radar notes and NFT approval requests,
# giveaway logs, auto mod, scam alerts, settings changes. Must NOT be the marketplace/shop channel (that is ignored).
# Choosing a logs channel in /setup in HΛVØCZ wins over this. Empty + nothing chosen = feature logs are not sent.
LOGS_CHANNEL_ID=
# staff channel for a copy of every shop receipt (empty = no copy; a failed copy never blocks a purchase)
RECEIPT_CHANNEL_ID=
# optional: category where private ticket channels are created
TICKET_CATEGORY_ID=
# optional: ticket channel linked in the game winner message
TICKET_CHANNEL_ID=
# optional: extra role allowed to use admin commands / see tickets
ADMIN_ROLE_ID=
# optional: only members with this role earn points; also the role pinged for games
VERIFIED_ROLE_ID=
# optional: comma separated channel IDs where messages/reactions earn NO points
EXCLUDED_CHANNEL_IDS=
# optional: only these channels for offline chat, comma separated (empty = every normal text channel)
CHAT_CHANNEL_IDS=

# ---------------------------------------------------------------- Boss + control channel (HΛVØCZ)
# Discord user ID of remo.sol: Vexo's boss in HΛVØCZ (empty = Vexo just says "remo.sol" without a mention)
BOSS_USER_ID=
# private channel where the boss/staff give Vexo orders in plain language (empty = off)
CONTROL_CHANNEL_ID=
# optional: comma separated role IDs that can also give orders (besides BOSS_USER_ID)
STAFF_ROLE_IDS=
# the time zone YOU write times in when giving orders (IANA name, e.g. Asia/Dhaka)
BOSS_TIMEZONE=Asia/Dhaka

# ---------------------------------------------------------------- Number guess game
# how long a game runs before it ends with no winner (minutes)
GAME_DURATION_MINUTES=15
# max guesses per member per game
GAME_MAX_GUESSES_PER_USER=30
# minutes before the start that the role-ping announcement goes out
GAME_ANNOUNCE_MINUTES=10

# ---------------------------------------------------------------- Marketplace
# true = when an item sells out, deactivate it. false = keep it listed as sold out
AUTO_REMOVE_SOLD_OUT=false

# ---------------------------------------------------------------- Time
# time zone for the points day and the daily job (IANA name)
TIMEZONE=Asia/Dhaka
# daily job (quality check + top 1), cron format. Default 11:55 PM. Keep it BEFORE midnight.
DAILY_CRON=55 23 * * *

# ---------------------------------------------------------------- Point rules (defaults shown)
# max activity points per member per day
DAILY_CAP=20
# max points per day from messages / reactions / quality
MESSAGE_CAP=10
REACTION_CAP=4
QUALITY_CAP=6
# bonus for the daily top member (outside the daily cap)
TOP_BONUS=5
# valid messages needed for 1 point
MESSAGES_PER_POINT=2
# quality score needed for 1 quality point
QUALITY_SCORE_PER_POINT=3
# minimum valid messages to be picked as top member
TOP_MIN_MESSAGES=5
# anti-farming filters
MIN_MESSAGE_LENGTH=8
MIN_SECONDS_BETWEEN_MESSAGES=5
MIN_ACCOUNT_AGE_DAYS=7
# messages kept per member per day for the nightly quality check
MAX_LOGGED_MESSAGES_PER_USER=30
# AI answers per member per hour (per server)
QA_PER_HOUR=10

# ---------------------------------------------------------------- Rumble Royale
# HΛVØCZ's Rumble channel ID (empty = Rumble off in HΛVØCZ; no other channel is ever used)
RUMBLE_CHANNEL_ID=
# fewer players than this when the join window closes = cancelled
RUMBLE_MIN_PLAYERS=3
RUMBLE_MAX_PLAYERS=100
# seconds between round cards (minimum 3)
RUMBLE_ROUND_SECONDS=6
# safety timeout in minutes after the rounds start
RUMBLE_MAX_MINUTES=20
# true = only VERIFIED_ROLE_ID members can press Join (HΛVØCZ)
RUMBLE_REQUIRE_VERIFIED=true
# join window length in minutes when none is given
RUMBLE_DEFAULT_JOIN_MINUTES=5
# longest join window in minutes (1440 = 24 hours)
RUMBLE_MAX_JOIN_MINUTES=1440
# a points prize above this needs a second confirm (typo guard)
RUMBLE_MAX_POINTS_PRIZE=100000
# heads-up ping this many minutes before a scheduled Rumble opens
RUMBLE_PRE_ANNOUNCE_MINUTES=5
# role-ping reminder / last ping, in seconds before the start
RUMBLE_REMIND_BEFORE_SECONDS=120
RUMBLE_FINAL_PING_SECONDS=10
# % chance per round that one eliminated player is revived, and max revives per game
RUMBLE_REVIVE_CHANCE=25
RUMBLE_MAX_REVIVES=2
# runners-up listed under the winner card (max 9)
RUMBLE_RUNNERS_SHOWN=5

# ---------------------------------------------------------------- Boss presence (HΛVØCZ; your hours are never shown)
# a gap this long since your last message = one welcome-back line (hours)
BOSS_AWAY_HOURS=4
# your usual offline window, 24-hour HH:MM on YOUR clock (same start and end = off)
BOSS_OFFLINE_START=06:00
BOSS_OFFLINE_END=18:00
# offline window: Vexo chats with a member only in a channel quiet for this many minutes
OFFLINE_QUIET_MINUTES=10
# max lines per offline chat reply
OFFLINE_CHAT_MAX_LINES=2
# after this many replies Vexo only answers if the member keeps addressing it
OFFLINE_CHAT_SOFT_REPLIES=2
# you wrote anything this recently (minutes) = you are around, Vexo does not cover for you
BOSS_ACTIVE_RECENT_MINUTES=15
# at most one note pinging you per member in this many minutes
BOSS_NOTE_COOLDOWN_MINUTES=30
# at most this many notes pinging you per channel per hour
BOSS_NOTE_CHANNEL_MAX=3

# ---------------------------------------------------------------- X post drop reward
# X_DROP_CHANNEL_ID: HΛVØCZ's X channel (empty = off in HΛVØCZ). Other servers get an "x-posts" channel from the
# automatic setup, or choose one in /setup. The points and the daily maximum below are the same for every server.
# channel ID, points per credited drop, max credited drops per member per day (0 = unlimited)
X_DROP_CHANNEL_ID=
X_DROP_POINTS=10
X_DROP_MAX_PER_DAY=5

# ---------------------------------------------------------------- Giveaways
# GIVEAWAY_CHANNEL_ID: HΛVØCZ's giveaway channel (empty = choose the channel in /giveaway start every time).
# Other servers get a "giveaways" channel from the automatic setup, or choose one in /setup.
# The bot needs Embed Links and Attach Files there, and "Mention @everyone" to ping for winners.
GIVEAWAY_CHANNEL_ID=

# ---------------------------------------------------------------- Radar and Personal Vexo channels (HΛVØCZ only)
# HΛVØCZ never gets channels created automatically. Create these three channels by hand in HΛVØCZ, then
# right-click each channel > Copy Channel ID and paste it here. Empty = that feature stays off in HΛVØCZ.
# Other servers do NOT use these: their channels are created by the automatic setup (or chosen in /setup).
# NFT_RADAR_CHANNEL_ID: approved NFT Radar posts go here.
NFT_RADAR_CHANNEL_ID=
# SOL_RADAR_CHANNEL_ID: the daily SOL market updates go here.
SOL_RADAR_CHANNEL_ID=
# VEXO_ASSISTANT_CHANNEL_ID: the "get-vexo-assistant" channel where members request Personal Vexo.
VEXO_ASSISTANT_CHANNEL_ID=

# ---------------------------------------------------------------- SOL Radar (daily SOL market updates)
# SOL Radar needs NO key: prices come from Binance's free public market data (data-api.binance.vision).
# COINGECKO_API_KEY: OPTIONAL. CoinGecko is only the backup and the source of the market-wide volume line; it
# also works with this empty. A free "Demo" key gives steadier limits: https://www.coingecko.com/en/api
# (sign up > Developer Dashboard > Add New Key).
COINGECKO_API_KEY=
# Default update times (4 or 5, 24-hour clock) and the clock they are on. Every server can set its own
# with /solradar times. SOL_RADAR_TIMEZONE examples: UTC, Asia/Dhaka, Europe/London.
SOL_RADAR_TIMES=01:00,06:00,11:00,16:00,21:00
SOL_RADAR_TIMEZONE=UTC

# ---------------------------------------------------------------- NFT Radar (upcoming Solana NFT mints)
# TAVILY_API_KEY: REQUIRED for NFT Radar (web research). Free plan: 1,000 searches a month, no card:
# https://tavily.com > sign up > copy the API key (starts with "tvly-"). Empty = NFT Radar is off; the bot and
# every other feature still work. Nothing is ever posted without an admin pressing Approve in the logs channel.
TAVILY_API_KEY=
# When Vexo looks for new projects (24-hour clock, UTC, shared by all servers). Each run uses about 3 searches.
NFT_RADAR_TIMES=09:00,21:00

# (PORT is set by Render automatically. Do not add it.)
