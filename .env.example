# ===== COPY THIS FILE AS ".env" AND FILL IN =====

# --- Discord (https://discord.com/developers/applications) ---
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=
# service_role key (secret, never share / never put in frontend)
SUPABASE_SERVICE_KEY=

# --- AI ---
# openai  OR  anthropic
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Discord channel / role IDs (Developer Mode on > right click > Copy ID) ---
# Q&A channel: bot answers community questions here (stays silent on casual chat)
ASK_CHANNEL_ID=
# daily top chatter announcement goes here. Number guess games also always run here.
GENERAL_CHANNEL_ID=
# prize cards with Redeem buttons (make it read-only for members)
# (also linked in the welcome message, if set)
MARKETPLACE_CHANNEL_ID=
# new-member welcome messages go here (empty = no welcomes)
# needs "Server Members Intent" ON in the Developer Portal (Bot page)
WELCOME_CHANNEL_ID=
# optional: rules channel, linked in the welcome message
RULES_CHANNEL_ID=
# admin-only log of every purchase
REDEEM_LOGS_CHANNEL_ID=
# optional: category where private ticket channels are created
TICKET_CATEGORY_ID=
# optional: extra role allowed to use admin commands / see tickets
ADMIN_ROLE_ID=
# optional: only members with this role earn points.
# Also pinged by the number guess game announcement (the role must be mentionable, or the bot needs "Mention All Roles")
VERIFIED_ROLE_ID=
# optional: comma separated channel IDs where messages/reactions earn NO points
EXCLUDED_CHANNEL_IDS=

# --- Vexo personality ---
# Discord user ID of remo.sol. Vexo mentions him when asked "who made you",
# and he can give orders in CONTROL_CHANNEL_ID.
# Empty = Vexo just says "remo.sol" without a mention.
BOSS_USER_ID=

# --- Control channel + tasks (number guess game) ---
# private channel where the boss/staff give Vexo orders in plain language (empty = feature off)
CONTROL_CHANNEL_ID=
# optional: comma separated role IDs that can also give orders (besides BOSS_USER_ID)
STAFF_ROLE_IDS=
# optional: ticket channel linked in the game winner message
TICKET_CHANNEL_ID=
# how long a game runs before it ends with no winner
GAME_DURATION_MINUTES=15
# max guesses per member per game
GAME_MAX_GUESSES_PER_USER=30
# minutes before the start that the role-ping announcement goes out (lower it only for testing, e.g. 3)
GAME_ANNOUNCE_MINUTES=10
# the time zone YOU write times in when giving orders (IANA name). Only used to understand your orders:
# Vexo stores times in UTC and always shows them as UTC ("14:30 UTC").
BOSS_TIMEZONE=Asia/Dhaka

# --- Marketplace ---
# true = when an item sells out, delete its card and deactivate it. false = keep the card (button disabled)
AUTO_REMOVE_SOLD_OUT=false

# --- Time ---
TIMEZONE=Asia/Dhaka
# daily job (quality check + top 1). Default 11:55 PM. Keep it BEFORE midnight.
DAILY_CRON=55 23 * * *

# --- Point rules (defaults shown) ---
DAILY_CAP=10
MESSAGE_CAP=5
REACTION_CAP=2
QUALITY_CAP=3
TOP_BONUS=5
MESSAGES_PER_POINT=2
QUALITY_SCORE_PER_POINT=3
TOP_MIN_MESSAGES=5
MIN_MESSAGE_LENGTH=8
MIN_SECONDS_BETWEEN_MESSAGES=5
MIN_ACCOUNT_AGE_DAYS=7
MAX_LOGGED_MESSAGES_PER_USER=30
QA_PER_HOUR=10

# --- Rumble Royale (Vexo hosts it; /rumble or a control channel order) ---
# the ONLY channel where Rumbles run (empty = Rumble off; Vexo never falls back to another channel)
RUMBLE_CHANNEL_ID=
# fewer players than this when the join window closes = cancelled
RUMBLE_MIN_PLAYERS=3
RUMBLE_MAX_PLAYERS=100
# seconds between round cards (minimum 3, lower values are raised to 3)
RUMBLE_ROUND_SECONDS=6
# safety timeout: a Rumble still running this many minutes after the rounds start is ended with no winner
RUMBLE_MAX_MINUTES=20
# true = only VERIFIED_ROLE_ID members can press Join
RUMBLE_REQUIRE_VERIFIED=true
# join window length when you don't say one
RUMBLE_DEFAULT_JOIN_MINUTES=5
# a points prize above this needs a second confirm (typo guard)
RUMBLE_MAX_POINTS_PRIZE=100000
# optional: heads-up ping this many minutes before a scheduled Rumble opens (default 5)
# RUMBLE_PRE_ANNOUNCE_MINUTES=5
# % chance per round (from round 2, with 4+ players left) that one eliminated player is revived
RUMBLE_REVIVE_CHANCE=25
# max revives per game (a player can be revived only once)
RUMBLE_MAX_REVIVES=2
# runners-up listed under the winner card (max 9)
RUMBLE_RUNNERS_SHOWN=5

# --- Boss presence (welcome back, offline window, cover). Your hours are never shown to anyone. ---
# a gap this long since your last message = one welcome-back line (hours, decimals ok)
BOSS_AWAY_HOURS=4
# your usual offline window, 24-hour HH:MM on YOUR clock (BOSS_TIMEZONE). Same start and end = window off
BOSS_OFFLINE_START=06:00
BOSS_OFFLINE_END=18:00
# offline window: Vexo chats with a member only in a channel quiet for this long
OFFLINE_QUIET_MINUTES=10
OFFLINE_CHAT_MAX_LINES=2
# after this many replies Vexo only answers if the member keeps addressing it
OFFLINE_CHAT_SOFT_REPLIES=2
# you wrote anything this recently = you are around, Vexo does not cover for you
BOSS_ACTIVE_RECENT_MINUTES=15
# at most one note pinging you per member in this many minutes
BOSS_NOTE_COOLDOWN_MINUTES=30
# at most this many notes pinging you per channel per hour
BOSS_NOTE_CHANNEL_MAX=3
# optional: only these channels for offline chat (empty = every normal text channel)
# CHAT_CHANNEL_IDS=

# --- Marketplace receipts ---
# staff channel for a copy of every shop receipt (empty = no copy; a failed copy never blocks a purchase)
RECEIPT_CHANNEL_ID=1564738511800897667
